{
  "name": "@testmate/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:clear-demo": "tsx src/db/cli.ts clear-demo",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@testmate/shared": "0.1.0",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "pdfkit": "0.20.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
