# Copy to .env only if you need to change defaults. Never commit real secrets.
# API server port. The Vite dev server (port 5173) proxies /api to it.
TESTMATE_API_PORT=4000
# SQLite file location (default: server/data/testmate.db).
# TESTMATE_DB_PATH=C:\path\to\testmate.db

# Secrets for API Studio requests and live chatbot endpoints. Reference them as {{secret:NAME}}
# in a header, URL or body; the server substitutes TESTMATE_SECRET_NAME. Values are never sent to the browser.
# TESTMATE_SECRET_SUPPORT_BOT_TOKEN=replace-me

# Online deployment only (see DEPLOY.md). Leave these unset for local use.
# TESTMATE_PUBLIC_MODE=1
# TESTMATE_ADMIN_KEY=generate-your-own-at-least-24-characters
# TESTMATE_TRUST_PROXY_HOPS=1
